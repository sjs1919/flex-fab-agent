# 敏感配置（含 API key，切勿提交）
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# 向量库持久化（Chroma 本地数据，可由脚本重建，勿提交）
chroma_db/

# SQLite 缓存数据库（运行时生成，勿提交）
*.db

# LangGraph checkpointer 落盘的会话状态（运行时生成，勿提交）
checkpoints.db
checkpoints.db-journal
checkpoints.db-wal
checkpoints.db-shm

# CodeGraph 索引（运行时生成）
.codegraph/

# 语义缓存向量库（运行时生成，勿提交）
cache_db/

# 运行时数据（指数环比 JSON，容器挂载卷内容，勿提交；仅根 data/，不影响 scripts/week*/data/）
/data/

# 评估 HTML 报告（运行时生成，勿提交）
demo/eval/reports/

# 临时文件
tmp/
~$*

# WAIC 2026 分析脚本（仅提交报告和源数据）
docs/waic2026/*.py

# 压缩包
*.zip
*.rar

# IDE / OS
.vscode/
.idea/
.DS_Store
